# Copier ce fichier en `.env` puis adapter les valeurs. `.env` n'est jamais versionné.

# --- Modèles locaux -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
BULL_BEAR_MODEL=llama3.1:8b
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
CRO_MODEL=qwen2.5-32b-instruct
CRO_STRUCTURED_METHOD=json_schema
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3

# --- Mémoire vectorielle (Qdrant) -----------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_FALLBACK_LOCAL=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEWS_TOP_K=3
NEWS_LOOKBACK_DAYS=7
EXPERIENCE_TOP_K=3

# --- Univers et stratégie -------------------------------------------------
TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,XOM,UNH
HISTORY_START=2016-01-01
SIGNAL_THRESHOLD=0.70
HORIZON_DAYS=10
TP_ATR_MULT=1.5
SL_ATR_MULT=3.0
INITIAL_CAPITAL=100000
KELLY_MULTIPLIER=0.25
MAX_POSITION_PCT=0.20
MAX_OPEN_POSITIONS=5
COST_BPS=5
VETO_COOLDOWN_DAYS=5
ENABLE_DARK_POOL=false

# --- Lecture des dépôts SEC par les LLM -------------------------------------
# Modèle de prise de notes (Ollama) ; par défaut celui des analystes Bull/Bear.
# FILING_NOTES_MODEL=llama3.1:8b
FILING_CHUNK_CHARS=12000
FILING_NUM_CTX=8192
FILING_MAX_CHARS=80000
# Ajoute les variables extraites au classifieur (à n'activer qu'après run_filings_study.py)
ENABLE_FILING_FEATURES=false

# --- Sources externes -----------------------------------------------------
# La SEC exige un User-Agent identifiant le client (nom + adresse de contact).
SEC_USER_AGENT=ai-hedge-fund-research contact@example.com

# --- Broker ---------------------------------------------------------------
# paper : simulateur local (aucun compte requis) ; alpaca : API Alpaca (paper uniquement par défaut)
BROKER=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
